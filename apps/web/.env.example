# Copy to apps/web/.env.local for local development.

# API base URL for browser-side fetches. With shared-domain cookies, this is
# the API origin directly — no proxy needed.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public web origin used when emitting absolute URLs (e.g. share links).
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# API base URL for server-side fetches (RSC). Same as NEXT_PUBLIC_API_URL in
# dev; in prod this might be an internal hostname (e.g. api.cluster.local).
API_INTERNAL_URL=http://localhost:4000
