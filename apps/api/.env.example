# Copy to apps/api/.env for local development. Never commit .env files.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# PostgreSQL — point at the docker-compose Postgres service by default.
DATABASE_URL=postgres://auction:auction_dev_password@localhost:5432/auction

# Redis — used for refresh-token allowlist, BullMQ queues, and Socket.IO adapter.
REDIS_URL=redis://localhost:6379

# JWT — generate strong secrets per environment. Do NOT reuse access/refresh secrets.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Cookie names — kept stable so the Next proxy can read/write them.
COOKIE_ACCESS_NAME=auction_at
COOKIE_REFRESH_NAME=auction_rt
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email — Brevo in prod; Mailhog SMTP locally.
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@auction.local
MAIL_FROM_NAME=Auction Platform
BREVO_API_KEY=

# Cloudinary — direct upload (signed) is preferred; backend never buffers files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=auction

# Web app origin used in email links.
WEB_BASE_URL=http://localhost:3000

# Throttler defaults; override per environment.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
