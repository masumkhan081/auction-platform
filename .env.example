# Root-level infrastructure variables consumed by docker-compose.yml.
# Copy to `.env` for local dev. Never commit `.env`.
#
# App-specific env vars live in apps/api/.env and apps/web/.env.local.

POSTGRES_USER=auction
POSTGRES_PASSWORD=auction_dev_password
POSTGRES_DB=auction
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
